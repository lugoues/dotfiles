#!/bin/bash
#
# Generates mise's own zsh completion. Every other tool caches its completion
# from a mise postinstall hook via _zsh_cache_completion (see .etc/zsh/zshenv),
# but mise is not a mise-managed tool, so nothing fires for it. Its release
# tarball ships fish completions and a man page, nothing for zsh.
#
# run_onchange_ keys off the version below, so this re-runs exactly when the
# pinned mise in .chezmoidata/versions.yaml changes, which is also when the
# external re-downloads the binary.
#
#   mise {{ .versions.mise }}
#
# after_ runs this once externals have landed, so the binary exists.

set -eu

mise_bin="${HOME}/.local/bin/mise"
out_dir="${HOME}/.local/share/zsh/completions"
out="${out_dir}/_mise"

if [ ! -x "${mise_bin}" ]; then
	echo "skip _mise: ${mise_bin} not installed" >&2
	exit 0
fi

mkdir -p "${out_dir}"

tmp="$(mktemp)"
if "${mise_bin}" completion zsh >"${tmp}" 2>/dev/null && [ -s "${tmp}" ]; then
	mv "${tmp}" "${out}"
	echo "generated _mise"
else
	rm -f "${tmp}"
	echo "failed to generate _mise from: ${mise_bin} completion zsh" >&2
	exit 1
fi
# vim: set syntax=gitconfig:

[user]
  name = Peter Brunner
  email = pbrunner@dteams.ai
  signingkey = ~/.local/etc/git/keys/1p-github-sign-dream-teams.pub

[commit]
  gpgsign = true

[gpg]
  format = ssh


[core]
  sshCommand="ssh -i ~/.local/etc/git/keys/1p-github-auth-dream-teams.pub -o IdentitiesOnly=yes"

style = "compact"
inline_height = 15
search_mode = "daemon-fuzzy"
exit_mode = "return-original"
recency_score_multiplier=1.2

filter_mode_shell_up_key_binding = "session"

{{ if eq .devcontainer true -}}
filter_mode = "workspace"
{{ else -}}
filter_mode = "host"
{{ end -}}

# Git repos = workspace
workspaces = true

sync_frequency = "10m"
auto_sync = true

# keymap_mode="vim-insert"
history_filter = [
  "^[ \t]*where.*$",
  "^[ \t]*which.*$",
  "^[ \t]*vim[ \t]*$",
  "^[ \t]*pwd[ \t]*$",
  "^[ \t]*su[ \t]*$",
  # "^[ \t]*sudo[ \t]*$",
  "^[ \t]*clear[ \t;]*$",
  "^[ \t]*cd[ \t]+(?:\\.(?:/|\\\\)?|\\.\\.(?:/|\\\\)?|~(?:/|\\\\)?|/)+[ \t]*$",
  "^[ \t]*ls(?:[ \t]*-[a-zA-Z]+)*[ \t]*(?:/[ \t]*$|~[ \t]*$|(?:\\.\\.(?:/|$))+[ \t]*$|[ \t]*$)"
]

common_subcommands = [
  "apt",
  "cargo",
  "composer",
  "dnf",
  "docker",
  "git",
  "go",
  "ip",
  "kubectl",
  "nix",
  "nmcli",
  "npm",
  "pecl",
  "pnpm",
  "podman",
  "port",
  "systemctl",
  "tmux",
  "yarn",
  "gt",
]

[sync]
records = true

[daemon]
enabled = true
autostart = true


[search]
recency_score_multiplier = 10.0
frequency_score_multiplier = 0.8
frecency_score_multiplier = 1.0
{{ if eq .devcontainer true -}}
filters = ["global", "session", "directory", "workspace"]
{{ end -}}
